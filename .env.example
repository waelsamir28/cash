# رابط قاعدة البيانات - ضعه في Vercel Dashboard
# مثال Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# مثال Supabase: postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# مثال Vercel Postgres: postgresql://default:pass@ep-xxx.postgres.vercel-storage.com/verceldb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
# بديل لبعض مزودي الخدمة
# POSTGRES_URL="postgresql://..."

# للتطوير المحلي فقط - لا تفعله في Vercel
# ALGAMAL_LOCAL_DB=1
# ALGAMAL_DATA_DIR=./data/algamal
